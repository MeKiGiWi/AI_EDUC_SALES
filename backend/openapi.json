          "name": {
            "type": "string",
            "title": "Name"
          },
          "level": {
            "$ref": "#/components/schemas/CompetencyLevel"
          },
          "argument": {
            "type": "string",
            "title": "Argument"
          },
          "quote": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quote"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "level",
          "argument",
          "quote",
          "recommendations"
