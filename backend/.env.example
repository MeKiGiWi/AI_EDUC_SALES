DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_sales_academy
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
BUYER_LLM_MODEL=deepseek/deepseek-v3.2
EVALUATION_LLM_MODEL=deepseek/deepseek-v3.2
EVALUATION_LLM_REASONING_EFFORT=medium
OPENROUTER_SITE_URL=http://localhost:8081
OPENROUTER_APP_NAME="AI Sales Academy"
MIN_MANAGER_TURNS=10
APP_ENV=development

# Уведомления о новых заявках на аудит по email (RU-SMTP, напр. Yandex/Mail.ru).
# Если SMTP_HOST или LEAD_NOTIFY_TO не заданы — заявки всё равно пишутся в БД, просто без письма.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# SMTP_USE_SSL=true        # для порта 465 определяется автоматически
SMTP_USER=
SMTP_PASSWORD=             # пароль приложения почты, не основной пароль
LEAD_NOTIFY_FROM=          # необязательно, по умолчанию = SMTP_USER
LEAD_NOTIFY_TO=            # куда слать уведомления о заявках

# Сколько дней хранить заявки в БД (старые авто-удаляются). По умолчанию 14.
LEAD_RETENTION_DAYS=14
