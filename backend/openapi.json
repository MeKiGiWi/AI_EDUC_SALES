{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Sales Academy Backend",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Healthcheck",
        "operationId": "healthcheck_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthcheck Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulator/scenarios": {
      "get": {
        "tags": [
          "simulator"
        ],
        "summary": "Get Scenarios",
        "operationId": "get_scenarios_api_v1_simulator_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioListResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulator/sessions": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Open Session",
        "operationId": "open_session_api_v1_simulator_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionCreateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreateResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulator/sessions/{session_id}/messages": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Reply To Sales",
        "operationId": "reply_to_sales_api_v1_simulator_sessions__session_id__messages_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionMessageCreateDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionMessageResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulator/sessions/{session_id}/finish": {
      "post": {
        "tags": [
          "simulator"
        ],
        "summary": "Close Session",
        "operationId": "close_session_api_v1_simulator_sessions__session_id__finish_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionFinishResponseDto"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompetencyLevel": {
        "type": "string",
        "enum": [
          "Junior",
          "Middle",
          "Senior"
        ],
        "title": "CompetencyLevel"
      },
      "EvaluationCompetencyRaw": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "level": {
            "$ref": "#/components/schemas/CompetencyLevel"
          },
          "argument": {
            "type": "string",
            "title": "Argument"
          },
          "quote": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Quote"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "level",
          "argument",
          "quote",
          "recommendations"
        ],
        "title": "EvaluationCompetencyRaw"
      },
      "EvaluationResultRaw": {
        "properties": {
          "overall_level": {
            "$ref": "#/components/schemas/CompetencyLevel"
          },
          "overall_comment": {
            "type": "string",
            "title": "Overall Comment"
          },
          "overall_recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Overall Recommendations"
          },
          "competencies": {
            "items": {
              "$ref": "#/components/schemas/EvaluationCompetencyRaw"
            },
            "type": "array",
            "title": "Competencies"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "overall_level",
          "overall_comment",
          "overall_recommendations",
          "competencies"
        ],
        "title": "EvaluationResultRaw"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageRole": {
        "type": "string",
        "enum": [
          "learner",
          "customer"
        ],
        "title": "MessageRole"
      },
      "ScenarioListResponseDto": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScenarioSummaryDto"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ScenarioListResponseDto"
      },
      "ScenarioStatus": {
        "type": "string",
        "enum": [
          "ready"
        ],
        "title": "ScenarioStatus"
      },
      "ScenarioSummaryDto": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "openingMessage": {
            "type": "string",
            "title": "Openingmessage"
          },
          "status": {
            "$ref": "#/components/schemas/ScenarioStatus"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "openingMessage",
          "status"
        ],
        "title": "ScenarioSummaryDto"
      },
      "SessionCreateDto": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty"
          }
        },
        "type": "object",
        "required": [
          "scenario_id"
        ],
        "title": "SessionCreateDto"
      },
      "SessionCreateResponseDto": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "message": {
            "$ref": "#/components/schemas/SessionMessageDto"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status",
          "message"
        ],
        "title": "SessionCreateResponseDto"
      },
      "SessionFinishResponseDto": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "evaluation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationResultRaw"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status"
        ],
        "title": "SessionFinishResponseDto"
      },
      "SessionMessageCreateDto": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "SessionMessageCreateDto"
      },
      "SessionMessageDto": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "SessionMessageDto"
      },
      "SessionMessageResponseDto": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "rude": {
            "type": "string",
            "title": "Rude"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/SessionMessageDto"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "status",
          "rude",
          "confidence",
          "messages"
        ],
        "title": "SessionMessageResponseDto"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "active",
          "finished"
        ],
        "title": "SessionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
